{
  "name": "filterednews",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "spike": "node --env-file-if-exists=.env scripts/spike.ts",
    "postinstall": "effect-tsgo patch --oxlint"
  },
  "dependencies": {
    "@effect/ai-openrouter": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/sql-pg": "4.0.0",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.48.0",
    "@effect/vitest": "4.0.0",
    "@types/node": "22",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
